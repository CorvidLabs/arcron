# TestNet settings for the nest project (algonode public API)
ALGOD_SERVER=https://testnet-api.algonode.cloud
INDEXER_SERVER=https://testnet-idx.algonode.cloud

# Whose upkeeps are expected here, comma separated, addresses only: nothing
# resolves a name. `preflight` reports every other creator as one a watcher
# would announce, and without this its stranger row can only skip. On TestNet
# a skip is fair, since the registry is shared; on MainNet the notifier and
# `preflight-mainnet` both refuse to run without it.
# ARCRON_OURS=E5M2OH5XNDMNABJ6VOFOUVR2IKRPCGQH43PVC5P3DWQQ2LV2VJV2FJZQ3E

# Throwaway TestNet deployer mnemonic (25 words). NEVER use a real/mainnet account.
# DEPLOYER_MNEMONIC="word1 word2 ... word25"
