# Copy to deploy/keeper.env and fill in. Never commit the real file.
#
# The account that signs executions and receives the fees. A throwaway is
# fine on TestNet; it needs enough ALGO to pay 3,000 µALGO per execution
# until the fees it collects cover that.
KEEPER_MNEMONIC=

# Which app to service. Defaults to the canonical TestNet keeper app.
KEEPER_APP_ID=769802474

# TestNet endpoint. Any algod will do; this one needs no token.
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=
ALGOD_TOKEN=
