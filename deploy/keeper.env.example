# Copy to deploy/keeper.env (Docker) or /etc/arcron/keeper.env (systemd) and
# fill in. Never commit the real file.
#
# The account that signs executions and receives the fees. A throwaway is
# fine on TestNet; it needs enough ALGO to pay 3,000 µALGO per execution
# until the fees it collects cover that. Never the creator key, on any
# network: on MainNet this is a hot key on a server, and the creator key can
# rewrite the contract for as long as it is unfrozen.
KEEPER_MNEMONIC=

# Which app to service. Required: the bot has no default, because an older
# deployment's boxes are a different shape and it would rather refuse than
# misread them.
KEEPER_APP_ID=769891898

# systemd and compose take the network from here, not from the unit file.
# Leave this as testnet unless you mean to service MainNet.
ARCRON_NETWORK=testnet

# TestNet endpoint. Any algod will do; this one needs no token.
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=
ALGOD_TOKEN=

# A second algod to alternate with when the first sheds requests (HTTP 403 or
# 429). The laptop keeper was refused 4,949 times in one log by the free
# endpoint; a retry that goes back to the same edge is the same coin again.
# The token for the fallback is separate, empty for a public endpoint, so the
# primary's token is never sent to it.
# ALGOD_SERVER_FALLBACK=
# ALGOD_TOKEN_FALLBACK=

# Where the bot forwards what it earns, once the surplus passes the reserve.
# Optional here; under launchd it is mandatory, and the reasoning is the same
# on a server: a hot key accumulating for a month should be a decision.
# KEEPER_SWEEP_TO=

# --- MainNet ---------------------------------------------------------------
# Every line below changes together, and the bot refuses to start on MainNet
# without the first. See docs/design/mainnet-rollout.md for the order.
#
# No comments on the same line as a value, anywhere in this file: systemd's
# EnvironmentFile keeps everything after `=` including a trailing `# ...`, and
# an ALGOD_SERVER with a comment glued on turns every request into a 405.
#
# ALGOD_SERVER is our own node (deploy/vps/algod.compose.yaml, installed to
# /etc/arcron/algod.compose.yaml) and ALGOD_TOKEN the token it was started
# with; the fallback is the public endpoint, with no token.
# ARCRON_ALLOW_MAINNET=1
# ARCRON_NETWORK=mainnet
# KEEPER_APP_ID=
# ALGOD_SERVER=http://127.0.0.1:8080
# ALGOD_TOKEN=
# ALGOD_SERVER_FALLBACK=https://mainnet-api.algonode.cloud
# ALGOD_TOKEN_FALLBACK=
