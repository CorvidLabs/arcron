# Copy to deploy/notifier.env (Docker) or /etc/arcron/notifier.env (systemd)
# and fill in. Never commit the real file.
#
# The notifier is read-only: it holds no account and cannot sign. The only
# secret here is the webhook, and the worst it can do is post messages. On
# MainNet the notifier refuses to start without one (or an explicit
# --stdout), because a watcher posting to a log nobody reads is the failure
# it exists to prevent.
DISCORD_WEBHOOK_URL=

# Which app to watch. Defaults to the live TestNet keeper app.
KEEPER_APP_ID=769891898

# systemd and compose take the network from here, not from the unit file.
ARCRON_NETWORK=testnet

ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=
ALGOD_TOKEN=
# ALGOD_SERVER_FALLBACK=

# Whose upkeeps are expected here, comma separated. Any other creator is
# announced as a stranger, loudly, because on a deployment whose app id is
# meant to be unpublished a stranger is the one event that changes what
# happens next: the agreed answer is to freeze.
#
# Leaving this empty means nobody is treated as a stranger. That is correct on
# a shared TestNet app and refused on MainNet: the notifier will not start
# there without it. Read by the notifier directly, so the container and the
# systemd unit need no flag.
#
# TestNet deployer is below. On MainNet this must be corvid.algo
# (WGSHC4TYKYBS6EX5V5E377BQDLKWIIPBCFOLZQZIXCKHFIEKRPBFOMW25A) plus every
# other address you actually register from.
ARCRON_OURS=E5M2OH5XNDMNABJ6VOFOUVR2IKRPCGQH43PVC5P3DWQQ2LV2VJV2FJZQ3E

# --- MainNet ---------------------------------------------------------------
# ARCRON_ALLOW_MAINNET=1
# ARCRON_NETWORK=mainnet
# KEEPER_APP_ID=<the MainNet app id, from the create ceremony>
# ALGOD_SERVER=http://127.0.0.1:8080
# ALGOD_TOKEN=<the token that node was started with>
# ARCRON_OURS=WGSHC4TYKYBS6EX5V5E377BQDLKWIIPBCFOLZQZIXCKHFIEKRPBFOMW25A
