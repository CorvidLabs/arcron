# Copy to deploy/notifier.env and fill in. Never commit the real file.
#
# The notifier is read-only: it holds no account and cannot sign. The only
# secret here is the webhook, and the worst it can do is post messages.
DISCORD_WEBHOOK_URL=

# Which app to watch. Defaults to the canonical TestNet keeper app.
KEEPER_APP_ID=769823086

ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=
ALGOD_TOKEN=
