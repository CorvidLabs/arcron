# systemd alternative to the container, for a host that already runs Python.
#
#   sudo cp deploy/keeper-bot.service /etc/systemd/system/
#   sudo systemctl enable --now keeper-bot
#
# Expects the repository at /opt/arcron with its Poetry environment installed,
# and /etc/arcron/keeper.env holding KEEPER_MNEMONIC (chmod 600).

[Unit]
Description=Arcron keeper bot
Documentation=https://github.com/CorvidLabs/arcron/blob/main/docs/arcron.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keeper
WorkingDirectory=/opt/arcron
EnvironmentFile=/etc/arcron/keeper.env
ExecStart=/usr/local/bin/poetry run python -m scripts.keeper_bot --network testnet --log-format json
# Finish the scan in flight, then exit.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=10
# It only needs to talk to algod and read its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
