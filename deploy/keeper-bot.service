# systemd alternative to the container, for a host that already runs Python.
#
#   sudo cp deploy/keeper-bot.service /etc/systemd/system/
#   sudo systemctl enable --now keeper-bot
#
# deploy/vps/install.sh puts everything where this expects it. By hand:
# the runtime tree at /opt/arcron with its virtualenv at /opt/arcron/.venv
# (poetry install with POETRY_VIRTUALENVS_IN_PROJECT=true), and
# /etc/arcron/keeper.env holding KEEPER_MNEMONIC, chmod 640 root:keeper.

[Unit]
Description=Arcron keeper bot
Documentation=https://github.com/CorvidLabs/arcron/blob/main/docs/arcron.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=keeper
WorkingDirectory=/opt/arcron
EnvironmentFile=/etc/arcron/keeper.env
ExecStart=/opt/arcron/.venv/bin/python -m scripts.keeper_bot --log-format json
# Finish the scan in flight, then exit.
KillSignal=SIGTERM
TimeoutStopSec=30
# on-failure with the [Unit] start limit: a missing flag or a bad mnemonic
# exits at startup, and five of those in five minutes stops the unit with the
# error at the bottom of the journal. compose.yaml chose on-failure:3 for the
# same reason; this unit used to say always, and flapped every ten seconds.
Restart=on-failure
RestartSec=10
# It only needs to talk to algod and read its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Somewhere to keep the backoff state. Without this the bot cannot write it at
# all: ProtectSystem=strict makes the filesystem read-only and ProtectHome
# hides the home directory the default path lives under, so every restart
# forgot which upkeeps were failing and went straight back to retrying them.
# Nothing logged, because the bot treats an unwritable state file as "no state
# yet". XDG_STATE_HOME points the default path at the directory systemd
# creates, rather than teaching the bot about systemd.
StateDirectory=arcron
Environment=XDG_STATE_HOME=/var/lib

[Install]
WantedBy=multi-user.target
