# Copy to deploy/rain.env and fill in. Never commit the real file.
#
# The account that holds the one ticket, resolves draws, claims what it
# wins and redeposits it. A throwaway is fine on TestNet; fund it for the
# long haul, since only its own transaction fees ever draw it down (see
# scripts/rain_bot.py's module docstring for what circulates and what does
# not).
RAIN_MNEMONIC=

# Which rain app to watch. Required: the bot has no canonical default.
RAIN_APP_ID=769988156

# TestNet endpoint. Any algod will do; this one needs no token.
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=
ALGOD_TOKEN=
