# MainNet settings for the scripts that read the live deployment: health,
# clock, govern status, verify_build, keeper-preview. Copy to .env.mainnet and
# fill in. .env.mainnet is gitignored.
#
# Nothing in this file is secret, and that is deliberate. It stays on the
# machine that runs `health`, so it must never carry the creator key.
#
#   * DEPLOYER_MNEMONIC is NOT set here. For the one-off create ceremony it is
#     exported into that shell and gone with it:
#
#         read -rs DEPLOYER_MNEMONIC; export DEPLOYER_MNEMONIC
#         ARCRON_ALLOW_MAINNET=1 fledge run deploy-mainnet -- --with-pulse
#
#     `deploy-mainnet` refuses if it finds the line in this file, and refuses
#     any creator but corvid.algo
#     (WGSHC4TYKYBS6EX5V5E377BQDLKWIIPBCFOLZQZIXCKHFIEKRPBFOMW25A). Anything
#     else becomes the admin key of the app forever.
#
#   * ARCRON_ALLOW_MAINNET=1 does nothing in this file either. It is read
#     before the file loads, so it has to be exported in the shell, and that is
#     the point: choosing MainNet stays a separate, deliberate act per command.
#
#   * The keeper bot and the notifier do not read this file. They run on the
#     VPS from /etc/arcron/keeper.env and /etc/arcron/notifier.env, written
#     from deploy/keeper.env.example and deploy/notifier.env.example.

ALGOD_SERVER=https://mainnet-api.algonode.cloud
INDEXER_SERVER=https://mainnet-idx.algonode.cloud

# A second algod to alternate with when the first sheds requests (HTTP 403 or
# 429). Two public providers are the cheap version; the real fix is a node of
# our own on the VPS, which docs/hosting.md describes.
# ALGOD_SERVER_FALLBACK=

# The MainNet keeper app, once it exists. Every script that needs it refuses
# to guess rather than defaulting to a TestNet id. It is deliberately not in
# fledge.toml, README or the console: see docs/design/mainnet-rollout.md.
KEEPER_APP_ID=
