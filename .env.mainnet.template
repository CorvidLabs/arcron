# MainNet settings. Copy to .env.mainnet and fill in. .env.mainnet is gitignored.
#
# Create is permanent. DEPLOYER_MNEMONIC must be corvid.algo
# (WGSHC4TYKYBS6EX5V5E377BQDLKWIIPBCFOLZQZIXCKHFIEKRPBFOMW25A). Anything else
# becomes the admin key of the app forever.
#
# Talking to MainNet (keeper bot, health, notifier) also needs this flag, but
# those processes must NOT use this mnemonic — they use KEEPER_MNEMONIC in
# deploy/keeper.env.

ALGOD_SERVER=https://mainnet-api.algonode.cloud
INDEXER_SERVER=https://mainnet-idx.algonode.cloud

# ARCRON_ALLOW_MAINNET=1
# DEPLOYER_MNEMONIC="word1 word2 ... word25"
