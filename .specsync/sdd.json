{
  "version": 2,
  "enabled": true,
  "require_change_for_meaningful_files": false,
  "meaningful_paths": [
    "src/",
    "tests/",
    "site/",
    ".github/",
    "Cargo.toml",
    "Cargo.lock",
    "action.yml",
    "package.json",
    "bun.lock",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "Package.swift",
    "Package.resolved",
    "go.mod",
    "go.sum",
    "pyproject.toml",
    "uv.lock",
    "requirements.txt",
    ".specsync/sdd.json",
    ".specsync/config.toml",
    ".specsync/config.json",
    ".specsync/registry.toml",
    ".specsync/version",
    "."
  ],
  "ignored_paths": [
    ".specsync/",
    "specs/"
  ],
  "verification_commands": [
    "fledge run build",
    "fledge run test",
    "fledge run js-install",
    "fledge run js-test",
    "fledge run web-test"
  ],
  "custom_artifacts": {},
  "principles_file": null
}
