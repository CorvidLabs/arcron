// smart_contracts.pulse.contract.Pulse.tick_with[routing]() -> void:
tick_with:
    // smart_contracts/pulse/contract.py:31
    // @abimethod()
    txna ApplicationArgs 1
    dup
    len
    pushint 8
    ==
    assert // invalid number of bytes for arc4.uint64
    btoi
    txna ApplicationArgs 2
    dup
    intc_0 // 0
    extract_uint16 // on error: invalid array length header
    pushint 2
    +
    dig 1
    len
    ==
    assert // invalid number of bytes for arc4.dynamic_array<arc4.uint8>
    // smart_contracts/pulse/contract.py:39-46
    // # Bound the increment. Unbounded, one call could set the counter near
    // # the uint64 ceiling, after which every `tick` overflows and panics.
    // # The AVM panics rather than saturating, so the panic fails the inner
    // # call, which fails the whole execution, which means a keeper can never
    // # service this app again. That is a permanent wedge of the demo target
    // # for the price of one transaction, and on a contract with no update
    // # path there is no way back.
    // assert beats <= MAX_BEATS_PER_TICK, "Too many beats for one tick"
    dig 1
    pushint 1000000
    <=
    assert // Too many beats for one tick
    // smart_contracts/pulse/contract.py:47
    // self.beats.value += beats
    intc_0 // 0
    bytec_0 // "beats"
    app_global_get_ex
    assert // check self.beats exists
    uncover 2
    +
    bytec_0 // "beats"
    swap
    app_global_put
    // smart_contracts/pulse/contract.py:48
    // self.last_beat_round.value = Global.round
    bytec_1 // "last_beat_round"
    global Round
    app_global_put
    // smart_contracts/pulse/contract.py:49
    // self.last_note.value = note.native
    extract 2 0
    bytec_2 // "last_note"
    swap
    app_global_put
    // smart_contracts/pulse/contract.py:50
    // return self.beats.value
    intc_0 // 0
    bytec_0 // "beats"
    app_global_get_ex
    assert // check self.beats exists
    // smart_contracts/pulse/contract.py:31
    // @abimethod()
    itob
    bytec_3 // 0x151f7c75
    swap
    concat
    log
    intc_1 // 1
    return
