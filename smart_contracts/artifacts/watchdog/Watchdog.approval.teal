    txna ApplicationArgs 2
    dup
    len
    intc_2 // 8
    ==
    assert // invalid number of bytes for arc4.uint64
    dup
    btoi
    // smart_contracts/watchdog/contract.py:79
    // assert Txn.sender == Global.creator_address, "Only the creator can configure"
    txn Sender
    global CreatorAddress
    ==
    assert // Only the creator can configure
    // smart_contracts/watchdog/contract.py:80
    // assert self.threshold_rounds.value == 0, "Already configured"
    intc_0 // 0
    bytec_0 // "threshold_rounds"
