    assert // check self.threshold_rounds exists
    !
    assert // Already configured
    // smart_contracts/watchdog/contract.py:81
    // assert threshold_rounds >= MIN_THRESHOLD_ROUNDS, "Threshold below minimum"
    dup
    pushint 30
    >=
    assert // Threshold below minimum
    // smart_contracts/watchdog/contract.py:82-85
    // # A zero reporter can never sign, so the feed could only ever go stale
    // # and never recover. Nobody can reach this by attack, only a creator
    // # by typo, which is exactly when an assert is worth having.
    // assert reporter.native != Global.zero_address, "Reporter cannot be the zero address"
    dig 2
    global ZeroAddress
    !=
    assert // Reporter cannot be the zero address
    // smart_contracts/watchdog/contract.py:87
    // self.reporter.value = reporter.native
    bytec 5 // "reporter"
    uncover 3
    app_global_put
    // smart_contracts/watchdog/contract.py:88
    // self.threshold_rounds.value = threshold_rounds
    bytec_0 // "threshold_rounds"
    swap
    app_global_put
    // smart_contracts/watchdog/contract.py:89-90
    // # Start the clock, so a feed that never reports is caught too.
    // self.updated_round.value = Global.round
    bytec_1 // "updated_round"
    global Round
    app_global_put
    // smart_contracts/watchdog/contract.py:76
    // @abimethod()
    bytec_3 // 0x151f7c75
    swap
    concat
    log
    intc_1 // 1
    return


