execute_if_body@2:
    // smart_contracts/keeper/contract.py:194-198
    // # Escalation is measured from the last service, not from the
    // # schedule. Escalation exists to clear a market; once a keeper has
    // # arrived the market has cleared, so the backlog it then drains
    // # pays base rather than the ceiling.
    // lateness: UInt64 = Global.round - upkeep.last_serviced_round.as_uint64()
    global Round
    dig 3
    pushint 98
    intc_0 // 8
    box_extract // on error: index out of bounds
    btoi
    -
    dup
    bury 11
    // smart_contracts/keeper/contract.py:199
    // excess: UInt64 = UInt64(0)
    intc_2 // 0
    bury 12
    // smart_contracts/keeper/contract.py:200
    // if lateness > interval:
    dig 6
    >
    bz execute_after_if_else@4
    // smart_contracts/keeper/contract.py:201
    // excess = lateness - interval
    dig 9
    dig 6
    -
    bury 11

execute_after_if_else@4:
    // smart_contracts/keeper/contract.py:202
    // if excess > interval:
    dig 10
    dig 6
    >
    bz execute_after_if_else@6
    dig 5
    bury 11

execute_after_if_else@6:
    // smart_contracts/keeper/contract.py:204-205
    // # Linear from base to cap over one missed interval, then flat.
    // fee = base + (cap - base) * excess // interval
    dig 1
    -
    dig 10
    *
    dig 5
    /
    +
    b execute_after_if_else@7
