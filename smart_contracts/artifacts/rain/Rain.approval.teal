    itxn_field Fee
    // smart_contracts/rain/contract.py:323-332
    // result = itxn.ApplicationCall(
    //     app_id=Application(self.beacon_app.value),
    //     app_args=(
    //         arc4.arc4_signature("must_get(uint64,byte[])byte[]"),
    //         op.itob(round_number),
