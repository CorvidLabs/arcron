// smart_contracts.rain.contract.Rain.claim[routing]() -> void:
claim:
    // smart_contracts/rain/contract.py:291
    // allocation = Box(UInt64, key=op.concat(ALLOCATION_PREFIX, Txn.sender.bytes))
    bytec 12 // 0x61
    txn Sender
    concat
    // smart_contracts/rain/contract.py:292
    // assert allocation, "Nothing allocated to you"
    dup
    box_len
    bury 1
    assert // Nothing allocated to you
    // smart_contracts/rain/contract.py:293
    // amount = allocation.value
    dup
    box_get
    pop
    btoi
    swap
    // smart_contracts/rain/contract.py:294
    // del allocation.value
    box_del
    pop
    // smart_contracts/rain/contract.py:295
    // asset = self.prize_asset.value
    intc_0 // 0
    bytec_2 // "prize_asset"
    app_global_get_ex
    swap
    dup
    uncover 2
    assert // check self.prize_asset exists
    // smart_contracts/rain/contract.py:296
    // if asset == 0:
    bnz claim_else_body@4
    pop
    // smart_contracts/rain/contract.py:297-299
    // # Deleting the box releases its minimum balance back to the pot,
    // # where it pays for the next winner's allocation.
    // self.pot.value += ALLOCATION_MBR
    intc_0 // 0
    bytec_0 // "pot"
    app_global_get_ex
    assert // check self.pot exists
    intc_3 // 18900
    +
    bytec_0 // "pot"
    swap
    app_global_put
    // smart_contracts/rain/contract.py:300
    // itxn.Payment(receiver=Txn.sender, amount=amount).submit()
    itxn_begin
    txn Sender
    dig 1
    itxn_field Amount
    itxn_field Receiver
    intc_1 // pay
    itxn_field TypeEnum
    intc_0 // 0
    itxn_field Fee
    itxn_submit

claim_after_if_else@6:
    // smart_contracts/rain/contract.py:288
    // @abimethod()
    itob
    bytec_1 // 0x151f7c75
    swap
    concat
    log
    intc_1 // 1
    return

claim_else_body@4:
    // smart_contracts/rain/contract.py:302-306
    // # The freed minimum balance is ALGO and the pot is not, so it
    // # cannot be recycled into it. It stays in the app account, which is
    // # where the next allocation box's minimum balance comes from
    // # anyway, so nothing is stranded.
    // assert Txn.sender.is_opted_in(Asset(asset)), "Opt in to the prize asset first"
    txn Sender
    dig 1
    asset_holding_get AssetBalance
    bury 1
    assert // Opt in to the prize asset first
    // smart_contracts/rain/contract.py:307-311
    // itxn.AssetTransfer(
    //     xfer_asset=Asset(asset),
    //     asset_receiver=Txn.sender,
    //     asset_amount=amount,
    // ).submit()
    itxn_begin
    // smart_contracts/rain/contract.py:309
    // asset_receiver=Txn.sender,
    txn Sender
    dig 2
    itxn_field AssetAmount
    itxn_field AssetReceiver
    itxn_field XferAsset
    // smart_contracts/rain/contract.py:307
    // itxn.AssetTransfer(
    pushint 4 // axfer
    itxn_field TypeEnum
    intc_0 // 0
    itxn_field Fee
    // smart_contracts/rain/contract.py:307-311
    // itxn.AssetTransfer(
    //     xfer_asset=Asset(asset),
    //     asset_receiver=Txn.sender,
    //     asset_amount=amount,
    // ).submit()
    itxn_submit
    b claim_after_if_else@6


// smart_contracts.rain.contract.Rain.allocation_of[routing]() -> void:
allocation_of:
    // smart_contracts/rain/contract.py:314
    // @abimethod(readonly=True)
    txna ApplicationArgs 1
    dup
    len
    pushint 32
    ==
    assert // invalid number of bytes for arc4.static_array<arc4.uint8, 32>
    // smart_contracts/rain/contract.py:317
    // allocation = Box(UInt64, key=op.concat(ALLOCATION_PREFIX, who.bytes))
    bytec 12 // 0x61
    swap
    concat
    dup
    // smart_contracts/rain/contract.py:318
    // return allocation.value if allocation else UInt64(0)
    box_len
    bury 1
    bz allocation_of_ternary_false@3
    box_get
    assert // check Box exists
    btoi

allocation_of_ternary_merge@4:
    // smart_contracts/rain/contract.py:314
    // @abimethod(readonly=True)
    itob
    bytec_1 // 0x151f7c75
    swap
    concat
    log
    intc_1 // 1
    return

allocation_of_ternary_false@3:
    pop
    // smart_contracts/rain/contract.py:318
    // return allocation.value if allocation else UInt64(0)
    intc_0 // 0
    b allocation_of_ternary_merge@4
