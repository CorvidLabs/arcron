    intc_0 // 0
    bytec 10 // "draws_resolved"
    app_global_get_ex
    assert // check self.draws_resolved exists
    intc_1 // 1
    +
    bytec 10 // "draws_resolved"
    swap
    app_global_put
    // smart_contracts/rain/contract.py:276
    // self.draw_open.value = UInt64(0)
    bytec 5 // "draw_open"
    intc_0 // 0
    app_global_put
    // smart_contracts/rain/contract.py:280
    // draw_id=arc4.UInt64(self.draw_id.value),
    intc_0 // 0
    bytec 4 // "draw_id"
    app_global_get_ex
    assert // check self.draw_id exists
    itob
    // smart_contracts/rain/contract.py:282
    // prize=arc4.UInt64(self.prize.value),
    intc_0 // 0
    bytec 6 // "prize"
    app_global_get_ex
    assert // check self.prize exists
    itob
    // smart_contracts/rain/contract.py:279-284
    // Resolved(
    //     draw_id=arc4.UInt64(self.draw_id.value),
    //     winner=arc4.Address(winner),
    //     prize=arc4.UInt64(self.prize.value),
    //     winning_ticket=arc4.UInt64(winning_ticket),
