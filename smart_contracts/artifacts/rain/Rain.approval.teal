    // ).submit()
    itxn_submit
    itxn LastLog
    // smart_contracts/rain/contract.py:333-334
    // # ARC-4 return: 4-byte log prefix, then a byte[] as uint16 length + data.
    // return op.extract(result.last_log, 6, 32)
    extract 6 32
    // smart_contracts/rain/contract.py:260
    // winning_ticket = op.extract_uint64(randomness, 0) % self.tickets_snapshot.value
    intc_0 // 0
    extract_uint64
    intc_0 // 0
    bytec 9 // "tickets_snapshot"
    app_global_get_ex
    assert // check self.tickets_snapshot exists
    %
    // smart_contracts/rain/contract.py:262
    // Account, key=op.concat(TICKET_PREFIX, op.itob(winning_ticket))
    itob
    dup
    pushbytes 0x74
    swap
    concat
    // smart_contracts/rain/contract.py:261-263
    // winner = Box(
    //     Account, key=op.concat(TICKET_PREFIX, op.itob(winning_ticket))
    // ).value
    box_get
    swap
    dup
    uncover 2
    assert // check Box exists
    // smart_contracts/rain/contract.py:265
    // allocation = Box(UInt64, key=op.concat(ALLOCATION_PREFIX, winner.bytes))
    bytec 12 // 0x61
    swap
    concat
    dup
    // smart_contracts/rain/contract.py:266
    // if allocation:
    box_len
    bury 1
    bz resolve_else_body@3
    // smart_contracts/rain/contract.py:267-269
    // # This winner already has an unclaimed prize, so the reservation
    // # made at draw time is not needed; hand it back to the pot.
    // allocation.value += self.prize.value
    dup
    box_get
    assert // check Box exists
    btoi
    intc_0 // 0
    bytec 6 // "prize"
    app_global_get_ex
    assert // check self.prize exists
    +
    itob
    box_put
    // smart_contracts/rain/contract.py:270
    // self.pot.value += ALLOCATION_MBR
    intc_0 // 0
    bytec_0 // "pot"
    app_global_get_ex
    assert // check self.pot exists
    intc_3 // 18900
    +
    bytec_0 // "pot"
    swap
    app_global_put

resolve_after_if_else@4:
    // smart_contracts/rain/contract.py:274
    // self.last_winner.value = winner
    bytec 13 // "last_winner"
    dig 1
    app_global_put
    // smart_contracts/rain/contract.py:275
