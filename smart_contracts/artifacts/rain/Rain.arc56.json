{
    "name": "Rain",
    "structs": {},
    "methods": [
        {
            "name": "configure",
            "args": [
                {
                    "type": "uint64",
                    "name": "beacon_app"
                }
            ],
            "returns": {
                "type": "void"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Point at the randomness beacon. Creator only, once.\nThe beacon differs per network \u2014 and LocalNet has none, so tests point this at a stub implementing the same interface.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "enter",
            "args": [
                {
                    "type": "pay",
                    "name": "mbr_payment"
                }
            ],
            "returns": {
                "type": "uint64"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Buy one ticket for the sender. Returns its index.\nTickets persist across draws: buying once enters every future draw. Buying twice doubles the holder's odds and costs them two MBRs, which is the honest version of \"one entry per person\" on a chain where identity is free.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "deposit",
            "args": [
                {
                    "type": "pay",
                    "name": "payment"
                }
            ],
            "returns": {
                "type": "uint64"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Add to the pot. Anyone, any amount. Returns the new pot.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "draw",
            "args": [],
            "returns": {
                "type": "uint64"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Open a draw. Zero arguments \u2014 this is what Arcron calls.\nA no-op returning 0 when there is nothing to draw for, because a scheduled call that fails would trip keeper backoff and stop the whole demo. Being called on a quiet week must be uneventful, not an error.",
            "events": [
                {
                    "name": "Drawn",
                    "args": [
                        {
                            "type": "uint64",
                            "name": "draw_id"
                        },
                        {
                            "type": "uint64",
                            "name": "commit_round"
                        },
                        {
                            "type": "uint64",
                            "name": "prize"
                        },
                        {
                            "type": "uint64",
                            "name": "tickets"
                        }
                    ],
                    "desc": "Emitted when a draw opens \u2014 before anyone can know the outcome."
                }
            ],
            "recommendations": {}
        },
        {
            "name": "resolve",
            "args": [],
            "returns": {
                "type": "address"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Ask the beacon who won. Permissionless.\nSent by a participant rather than a keeper, because reading the beacon means an inner call to it and only the sender of the outer transaction can make that app available.",
            "events": [
                {
                    "name": "Resolved",
                    "args": [
                        {
                            "type": "uint64",
                            "name": "draw_id"
                        },
                        {
                            "type": "address",
                            "name": "winner"
                        },
                        {
                            "type": "uint64",
                            "name": "prize"
                        },
                        {
                            "type": "uint64",
                            "name": "winning_ticket"
                        }
                    ],
                    "desc": "Emitted when the beacon has spoken."
                }
            ],
            "recommendations": {}
        },
        {
            "name": "claim",
            "args": [],
            "returns": {
                "type": "uint64"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Pull your prize. Only the winner can, and only for themselves.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "allocation_of",
            "args": [
                {
                    "type": "address",
                    "name": "who"
